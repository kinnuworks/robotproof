<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="lid">
    <visual>
      <geometry>
        <mesh filename="meshes/lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="body" />
    <child link="lid" />
    <origin rpy="0 0 0" xyz="-0.00560000 0.06104686 -0.06010000" />
    <axis xyz="1.00000000 0.00000000 0.00000000" />
    <limit lower="-2.094395" upper="0.000000" effort="10" velocity="1" />
  </joint>
</robot>