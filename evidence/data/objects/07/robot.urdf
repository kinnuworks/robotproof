    <axis xyz="-0.01559700 0.99986700 -0.00486300" />
    <limit lower="0.000000" upper="2.094395" effort="10" velocity="1" />
  </joint>
  <joint name="drawer_dispenser_joint" type="prismatic">
    <parent link="base" />
    <child link="drawer_dispenser" />
    <origin rpy="0 0 0" xyz="-0.19134400 0.75996801 0.01169800" />
