<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="keyboard_lid">
    <visual>
      <geometry>
        <mesh filename="meshes/keyboard_lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="keyboard_lid_joint" type="revolute">
    <parent link="base" />
    <child link="keyboard_lid" />
    <origin rpy="0 0 0" xyz="0.73795800 1.12055695 0.74230300" />
    <axis xyz="-0.99705300 -0.06735800 -0.03670700" />
    <limit lower="0.000000" upper="1.570796" effort="10" velocity="1" />
  </joint>
</robot>